    ["text/primary", "bg/base", 4.5, "本文"],
    ["text/primary", "bg/alt", 4.5, "本文（交互背景）"],
    ["text/secondary", "bg/base", 4.5, "説明文・ナビ"],
    ["text/secondary", "bg/alt", 4.5, "説明文（交互背景）"],
    ["text/muted", "bg/base", 4.5, "注釈"],
    ["text/muted", "bg/alt", 4.5, "注釈（交互背景）"],
    ["text/inverse", "brand/primary", 4.5, "ボタンの文字"],
    ["text/inverse", "brand/hover", 4.5, "ボタンの文字（hover）"],
    ["brand/primary", "bg/base", 4.5, "リンク・小ラベル"],
    ["brand/primary", "brand/subtle", 4.5, "タグ（ブランド色の文字＋淡い背景）"],
    ["text/inverse", "bg/footer", 4.5, "フッター"],
    ["border/strong", "bg/base", 3, "入力欄・ボタンの枠（非テキスト）"]
  ],
  "allowUndefinedVars": []
