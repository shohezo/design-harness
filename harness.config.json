{
  "$comment": "検査の対象と条件。プロジェクトに合わせてここだけ書き換える（スクリプトは触らない）。",
  "styles": "ui/src/styles",
  "tokens": "ui/src/tokens/tokens.json",
  "tokensCss": "ui/src/tokens/tokens.css",
  "spBreakpoint": 640,
  "pages": [
    { "name": "home", "path": "/" }
  ],
