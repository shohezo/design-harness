{
  "$comment": "デザインの値の正（Single Source of Truth）。Figma Variables を使うなら同じ名前・同じ値にそろえる。変更したら npm run tokens。見本: 架空のパン屋「ほしの製パン」。",
  "primitive": {
    "color": {
      "wheat": { "50": "#FBF6EE", "100": "#F4E8D4", "500": "#C98B3C", "700": "#8C5A1C", "800": "#6F4614" },
      "ink": { "500": "#6E6052", "700": "#54473A", "900": "#2B2219" },
      "sand": { "200": "#E7DDCF", "400": "#9C8B78" },
      "white": { "0": "#FFFFFF" }
    },
    "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "2xl": 32, "3xl": 48, "section": 96 },
    "radius": { "sm": 4, "md": 8, "lg": 16, "pill": 999 },
    "size": {
      "header-h": { "pc": 72, "sp": 60 },
      "content-w": { "pc": 1120, "sp": 1120 },
      "tap": { "pc": 44, "sp": 44 }
    },
    "font-size": {
      "xs": { "pc": 12, "sp": 12 },
      "sm": { "pc": 14, "sp": 13 },
      "md": { "pc": 16, "sp": 16 },
      "lg": { "pc": 20, "sp": 18 },
      "xl": { "pc": 28, "sp": 22 },
      "2xl": { "pc": 48, "sp": 32 }
    },
    "line-height": { "tight": "1.2", "heading": "1.45", "body": "1.85" },
    "font-weight": { "regular": "400", "bold": "700" },
    "font-family": {
      "sans": "\"Noto Sans JP\", \"Hiragino Sans\", sans-serif",
      "display": "\"DM Serif Display\", Georgia, serif"
    },
    "shadow": {
      "sm": "0 1px 2px rgba(43, 34, 25, .08)",
      "lg": "0 12px 32px rgba(43, 34, 25, .14)"
    }
  },
  "semantic": {
    "color": {
      "brand/primary": { "ref": "color.wheat.700", "css": "brand" },
      "brand/hover": { "ref": "color.wheat.800", "css": "brand-hover" },
      "brand/subtle": { "ref": "color.wheat.50", "css": "brand-subtle" },
      "accent": { "ref": "color.wheat.500", "css": "accent" },
      "text/primary": { "ref": "color.ink.900", "css": "text" },
      "text/secondary": { "ref": "color.ink.700", "css": "text-2" },
      "text/muted": { "ref": "color.ink.500", "css": "text-muted" },
      "text/inverse": { "ref": "color.white.0", "css": "text-inverse" },
      "bg/base": { "ref": "color.white.0", "css": "bg" },
      "bg/alt": { "ref": "color.wheat.50", "css": "bg-alt" },
      "bg/footer": { "ref": "color.ink.900", "css": "bg-footer" },
      "border/default": { "ref": "color.sand.200", "css": "line" },
      "border/strong": { "ref": "color.sand.400", "css": "line-strong" }
    }
  },
  "text-styles": {
    "display/hero": { "size": "2xl", "weight": "bold", "lh": "tight", "family": "display" },
    "heading/section": { "size": "xl", "weight": "bold", "lh": "heading" },
    "heading/card": { "size": "lg", "weight": "bold", "lh": "heading" },
    "body/m": { "size": "md", "weight": "regular", "lh": "body" },
    "body/s": { "size": "sm", "weight": "regular", "lh": "body" },
    "label/overline": { "size": "xs", "weight": "bold", "lh": "tight", "ls": ".12em" }
  }
}
